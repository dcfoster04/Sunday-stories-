# Copy to .env and fill in as needed. Nothing here is required to run the
# app locally — SQLite works out of the box with no setup.

# Local dev default. For production, point this at a Postgres/Supabase
# connection string (see prisma/schema.prisma + PROJECT_NOTES.md) —
# swapping providers is a two-line change.
DATABASE_URL="file:./dev.db"

# Public site URL, used for metadata + absolute share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. When unset, generateLeagueScoutingReport() and friends fall
# back to a clean deterministic mock — see src/lib/ai/service.ts.
ANTHROPIC_API_KEY=
